# Dashboard API
SESSION_SECRET=change-me-in-production
PASSWORD_HASH=
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rtcstats

# S3/MinIO (optional)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=rtcstats-dumps

# Analyzer
ANALYZER_POLL_INTERVAL_MS=10000
ANALYZER_BATCH_SIZE=100
# Compressed dumps larger than this are not downloaded for MOS scoring (25 MB)
ANALYZER_MOS_MAX_DUMP_BYTES=26214400

# Dashboard DB roles
DASHBOARD_READER_PASSWORD=dashboard_reader
DASHBOARD_WRITER_PASSWORD=dashboard_writer
